{
  "$schema": "https://registry.kdco.dev/schemas/worktree.json",

  // Worktree plugin configuration
  // Documentation: https://github.com/kdcokenny/ocx
  //
  // This file configures syncing and lifecycle hooks for git worktrees.
  // Worktree creation, placement and removal belong to the host worktree
  // tooling documented above, not to this repository's plugin.
  //
  // There is no worktree routing for morph_edit here. The tool accepts only
  // target_filepath, instructions and code_edit, rejects workdir and taskId,
  // and cannot select a root outside the invoking session. Start a session
  // in a worktree to edit within it.

  "sync": {
    // Files to copy from main worktree to new worktrees
    // Example: [".env", ".env.local", "dev.sqlite"]
    "copyFiles": [],

    // Directories to symlink (saves disk space)
    // Example: ["node_modules"]
    "symlinkDirs": [],

    // Patterns to exclude from copying
    "exclude": []
  },

  "hooks": {
    // Commands to run after worktree creation
    // Example: ["pnpm install", "docker compose up -d"]
    "postCreate": [],

    // Commands to run before worktree deletion
    // Example: ["docker compose down"]
    "preDelete": []
  }
}
