{
  "name": "opencode-morph-fast-apply",
  "version": "1.10.2",
  "description": "OpenCode plugin for Morph Fast Apply - 10x faster code editing",
  "type": "module",
  "main": "index.ts",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "index.ts",
    "impl.ts",
    "src/",
    "README.md",
    "LICENSE",
    "instructions/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "ci": "bun run check"
  },
  "dependencies": {
    "@opencode-ai/plugin": "latest",
    "diff": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "latest",
    "@types/diff": "^7.0.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "keywords": [
    "opencode",
    "plugin",
    "morph",
    "fast-apply",
    "code-editing"
  ],
  "author": "JRedeker",
  "repository": {
    "type": "git",
    "url": "https://github.com/JRedeker/opencode-morph-fast-apply.git"
  },
  "license": "MIT"
}
